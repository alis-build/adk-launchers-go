#!/usr/bin/env sh
set -e

APP_DIR="$(cd "$(dirname -- "$0")/.." && pwd)"
REPO_ROOT="$(cd "$APP_DIR/../.." && pwd)"

STAGED="$(git -C "$REPO_ROOT" diff --cached --name-only)"
echo "$STAGED" | grep -q '^console/app/' || exit 0

cd "$APP_DIR"
pnpm build
pnpm test
git -C "$REPO_ROOT" add console/app/dist
